F or Newton raphson method
 Input:
def f(x):
return (x**3 - 5*x + 1)

a = float(input("Enter the first guess: "))
b = float(input("Enter the second guess: "))
n = int(input("Enter the number of iterations: "))

i = 0
while i < n:
c = (a*f(b) - b*f(a)) / (f(b) - f(a))
print(f"For {i+1}th iteration root is {round(c,4)}")

if f(a) * f(c) < 0:
b = c
else:
a = c

i = i + 1
