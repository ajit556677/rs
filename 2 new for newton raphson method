 return (x**3 - 5*x + 1)
def df(x):
 return (3*x**2 - 5)
x0 = float(input("Enter the initial guess: "))
n = int(input("Enter the number of iterations: "))
i = 0
while i < n:
 x1 = x0 - (f(x0) / df(x0))
