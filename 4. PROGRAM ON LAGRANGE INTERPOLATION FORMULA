PROGRAM ON LAGRANGE INTERPOLATION FORMULA
INPUT:
import numpy as np

n = int(input("Enter number of data points: "))

x = np.zeros(n)
y = np.zeros(n)

print("Enter data for x and y:")
for i in range(n):
    x[i] = float(input("x[%d] = " % i))
    y[i] = float(input("y[%d] = " % i))

xp = float(input("Enter interpolation point: "))

yp = 0

for i in range(n):
    p = 1
    for j in range(n):
        if i != j:
            p = p * (xp - x[j]) / (x[i] - x[j])
    yp = yp + p * y[i]

print("Interpolated value at x = %f is y = %f" % (xp, yp))

